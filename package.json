{
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "prettier --write ./**/*.{js,ts,vue,md,html,css}",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "cleanup": "nuxt cleanup",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.2",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/image": "^2.2.1",
    "@takumi-rs/core": "^2.19.0",
    "nuxt": "^4.6.3",
    "nuxt-og-image": "^7.0.7",
    "nuxt-security": "^2.7.0",
    "sitemap": "^10.0.0"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/logos": "^1.2.18",
    "@iconify-json/simple-icons": "^1.2.101",
    "@unocss/nuxt": "^66.12.0",
    "prettier": "^3.9.10",
    "prettier-plugin-mdc": "^0.2.1",
    "typescript": "^7.0.2",
    "unocss": "^66.12.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.x"
  },
  "prettier": {
    "printWidth": 120,
    "proseWrap": "always",
    "plugins": [
      "prettier-plugin-mdc"
    ],
    "overrides": [
      {
        "files": [
          "*.md"
        ],
        "options": {
          "parser": "mdc"
        }
      }
    ]
  },
  "overrides": {
    "@rollup/plugin-terser": "1.0.0",
    "zod": ">=4.6.6",
    "katex": ">=0.18.2"
  }
}
